# Copy this file to .env and fill it in. Never share the .env file.

# --- Summaries (needed for the summarized digest and for breaking alerts) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- How texts get sent: twilio | ntfy | console ---
# "console" just prints to the terminal so you can test without sending anything.
SMS_PROVIDER=console

# Twilio (real SMS). Needs a Twilio account and a Twilio phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
MY_PHONE=+1XXXXXXXXXX

# ntfy (free push notification to the ntfy phone app, not a true SMS)
NTFY_TOPIC=pick-a-long-random-topic-name

# --- Optional tuning (defaults shown) ---
# NEWSBOT_TZ=America/New_York
# DIGEST_HOUR=9
# POLL_MINUTES=10
# MAX_ALERTS_PER_DAY=6
# QUIET_START=23
# QUIET_END=7
# ITEMS_PER_SECTION=5
